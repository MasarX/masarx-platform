{
  "cli": {
    "version": ">= 13.3.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "FIELDOPS_BUILD_PROFILE": "development",
        "NEXT_PUBLIC_FIELDOPS_APP_ID_SUFFIX": ".dev"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "stg": {
      "distribution": "internal",
      "channel": "stg",
      "env": {
        "FIELDOPS_BUILD_PROFILE": "stg",
        "NEXT_PUBLIC_FIELDOPS_APP_ID_SUFFIX": ".stg"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "FIELDOPS_BUILD_PROFILE": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

