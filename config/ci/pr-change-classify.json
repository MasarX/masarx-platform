{
  "version": 1,
  "root_manifest_ci_script_name_re": "^(?:ci|lint|ops|test):[a-z0-9][a-z0-9:_-]*$",
  "profiles": [
    {
      "id": "docs",
      "reason": "docs_only",
      "skip_preview": true,
      "run_fast_checks": false,
      "include_re": [
        "^docs/",
        "\\.mdx?$"
      ]
    },
    {
      "id": "ci",
      "reason": "ci_only",
      "skip_preview": true,
      "run_fast_checks": true,
      "include_re": [
        "^\\.github/",
        "^config/ci/",
        "^scripts/ops/audit/",
        "^scripts/ops/ci/",
        "^scripts/ops/security-(?:audit-inventory|scan-gate)\\.js$",
        "^scripts/ops/remote-workflow\\.js$",
        "^scripts/ops/setup-branch-protection\\.js$",
        "^scripts/ops/pr-ready\\.js$",
        "^scripts/utils/pg-hostaddr\\.js$",
        "^scripts/ops/objectives-lint\\.js$",
        "^scripts/ops/planning-os/",
        "^config/ops/runtime-container-policy\\.json$",
        "^scripts/ops/runtime-leases/",
        "^scripts/ops/workspace/(?:docker-runtime|local-start|phase-runtime-bootstrap)\\.js$",
        "^scripts/ops/branch-converge(?:-(?:cleanup(?:-adapters|-cli)?|decisions-generate|ignored-paths|inventory-coordinator|provider-(?:cleanup-adapters|snapshot(?:-coordinator)?)|runtime-(?:inventory|schema)|supplemental-inventory))?\\.js$",
        "^config/ops/branch-convergence-(?:cleanup-policy|policy)\\.json$",
        "^docs/",
        "^tests/load/",
        "^tests/unit/",
        "\\.mdx?$"
      ]
    },
    {
      "id": "ui",
      "reason": "ui_only",
      "skip_preview": true,
      "run_fast_checks": true,
      "include_re": [
        "^apps/",
        "^packages/ui/",
        "^packages/mobile-core/",
        "^\\.storybook/",
        "^assets/"
      ],
      "exclude_re": [
        "^packages/api/",
        "^packages/auth/",
        "^packages/config/"
      ]
    }
  ]
}
