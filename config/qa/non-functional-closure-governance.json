        "command": "node scripts/ops/quality/non-functional-class-gate-proof.js --class quality_observability_and_sla_visibility --out tmp/non-functional-class-proofs/observability-manifest.json"
      },
      "thresholds": [
        {
          "metric": "coverage_manifest_missing_or_unowned_suites",
          "operator": "equals",
          "value": 0,
          "evidence_artifact": "coverage-manifest"
        },
        {
          "metric": "required_decision_log_gaps",
          "operator": "equals",
