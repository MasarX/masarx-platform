      ],
      "explicit_gate_proof": {
        "manifest_type": "resilience-run-report",
        "script": "scripts/ops/quality/non-functional-class-gate-proof.js",
        "test": "tests/quality/non-functional-resilience-recovery-gate-proof.test.js",
        "command": "node scripts/ops/quality/non-functional-class-gate-proof.js --class quality_resilience_and_recovery --out tmp/non-functional-class-proofs/resilience-run-report.json"
      },
      "thresholds": [
        {
          "metric": "coverage_manifest_missing_or_unowned_suites",
          "operator": "equals",
          "value": 0,
          "evidence_artifact": "coverage-manifest"
        },
        {
          "metric": "webhook_replay_idempotency_violations",
          "operator": "equals",
          "value": 0,
          "evidence_artifact": "resilience-run-report"
        },
        {
          "metric": "offline_sync_unreconciled_required_events",
          "operator": "equals",
          "value": 0,
          "evidence_artifact": "resilience-run-report"
        },
        {
          "metric": "jest_resilience_required_failures",
          "operator": "equals",
          "value": 0,
          "evidence_artifact": "jest-report"
        }
      ],
      "pass_conditions": [
        {
          "id": "coverage_manifest_same_sha_passed",
          "evidence_artifact": "coverage-manifest",
          "assertion": "Every required lane publishes same-SHA coverage with zero missing, failed, skipped, or silent-skip owner suites."
        },
        {
          "id": "resilience_run_report_passed",
          "evidence_artifact": "resilience-run-report",
          "assertion": "The resilience run report proves replay, retry, outage, and offline-sync branches completed without duplicate side effects."
        },
        {
          "id": "resilience_jest_report_passed",
          "evidence_artifact": "jest-report",
          "assertion": "The Jest report includes the required queue and replay suites with no failed or skipped required tests."
        }
      ],
      "missing_deliverables": [
        "required-lane coverage-manifest publication",
        "required-lane resilience-run-report publication",
        "required-lane jest-report publication",
        "fresh required-lane evidence for local-dedicated, preview-cloud, and shared-stg-readiness"
